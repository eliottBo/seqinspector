

params {
    bai = null
    bait_intervals = null
    target_intervals = null
}

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    withName: PICARD_COLLECTHSMETRICS {
        ext.args = { [
            "--COVERAGE_CAP=50000",
            "--METRIC_ACCUMULATION_LEVEL=ALL_READS"
			].join(' ') }
    }
}
